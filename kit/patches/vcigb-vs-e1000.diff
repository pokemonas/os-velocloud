diff -ruN -x LICENSE -x README dev/e1000/e1000_vc.c dev/vcigb/e1000_vc.c
--- dev/e1000/e1000_vc.c	1970-01-01 03:00:00.000000000 +0300
+++ dev/vcigb/e1000_vc.c	2026-10-14 11:54:41.262542739 +0300
@@ -0,0 +1,602 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * VeloCloud Edge 520/540 ("edge5x0") board support for the I354 (igb).
+ *
+ * Port of the Linux glue from github.com/gallops-gannets/velo540openwrt
+ * (igb_vc.c, vc-edge5x0-mdio.c, /etc/init.d/velo540-switch), itself derived
+ * from VeloCloud's GPL igb_vc.c.
+ *
+ * I354 wiring on these boards (identified by NVM words 6/7 = "Vc" "5X"):
+ *   func 0  SerDes -> Marvell 88E6176 switch A port 4 (LAN5-8), no PHY.
+ *           The switch SMI is on this function's own MDIO pins.
+ *   func 1  same, switch B (LAN1-4).
+ *   func 2  SGMII -> Marvell 88E1514 PHY (GE1), PHY addr 0 on a GPIO
+ *           bit-bang MDIO bus (SoC core GPIO 13 = MDIO, 14 = MDC).
+ *   func 3  same, GE2, PHY addr 1.
+ *   The 88E1514s are held in reset by pin 4 of a PCA9557 at I2C 0x18 on a
+ *   GPIO bit-bang I2C bus (GPIO 11 = SDA, 12 = SCL).
+ *
+ * The switches are brought up as plain unmanaged 4-port switches (the
+ * velo540-switch "switch_up" sequence), once per boot.
+ */
+
+#include "e1000_api.h"
+#include "e1000_vc.h"
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/bus.h>
+#include <sys/sbuf.h>
+#include <sys/sysctl.h>
+#include <machine/cpufunc.h>
+#include <x86/pci_cfgreg.h>
+
+#define VC_NVM_WORD		0x06
+#define VC_ID			0x5663	/* "Vc" */
+#define VC_ID_EDGE5X0		0x3558	/* "5X" */
+
+/* Atom C2000 LPC (0:31.0): GPIO base address register, core-well bank 0 */
+#define VC_LPC_GBASE		0x48
+#define VC_GP_USE_SEL		0x00
+#define VC_GP_IO_SEL		0x04	/* 1 = input */
+#define VC_GP_LVL		0x08
+
+#define VC_GPIO_SDA		11
+#define VC_GPIO_SCL		12
+#define VC_GPIO_MDIO		13	/* rev B boards; rev A: 11 */
+#define VC_GPIO_MDC		14	/* rev B boards; rev A: 12 */
+
+#define VC_PCA_ADDR		0x18
+#define VC_PCA_PHY_RESET	4
+
+static struct mtx vc_gpio_mtx;
+MTX_SYSINIT(vc_gpio, &vc_gpio_mtx, "vcigb gpio", MTX_DEF);
+
+static u_int vc_gbase;		/* 0 = not probed yet */
+static u32 vc_lvl;		/* shadow of the bank-0 output levels */
+static bool vc_phys_released;
+static bool vc_switch_done[2];
+
+/* ---------------------------------------------------------------- GPIO */
+
+static bool
+vc_gpio_init(void)
+{
+	u32 gb, use;
+
+	if (vc_gbase != 0)
+		return (true);
+	gb = pci_cfgregread(0, 0, 31, 0, VC_LPC_GBASE, 4) & 0xff80;
+	if (gb == 0)
+		return (false);
+	use = inl(gb + VC_GP_USE_SEL);
+	use |= (1u << VC_GPIO_SDA) | (1u << VC_GPIO_SCL) |
+	    (1u << VC_GPIO_MDIO) | (1u << VC_GPIO_MDC);
+	outl(gb + VC_GP_USE_SEL, use);
+	vc_lvl = inl(gb + VC_GP_LVL);
+	vc_gbase = gb;
+	printf("vcigb: GPIO base 0x%x, USE_SEL 0x%x\n", gb,
+	    inl(gb + VC_GP_USE_SEL));
+	return (true);
+}
+
+static void
+vc_gpio_dir(int pin, bool input)
+{
+	u32 io = inl(vc_gbase + VC_GP_IO_SEL);
+
+	if (input)
+		io |= 1u << pin;
+	else
+		io &= ~(1u << pin);
+	outl(vc_gbase + VC_GP_IO_SEL, io);
+}
+
+static void
+vc_gpio_set(int pin, int val)
+{
+	if (val)
+		vc_lvl |= 1u << pin;
+	else
+		vc_lvl &= ~(1u << pin);
+	outl(vc_gbase + VC_GP_LVL, vc_lvl);
+}
+
+static int
+vc_gpio_get(int pin)
+{
+	return ((inl(vc_gbase + VC_GP_LVL) >> pin) & 1);
+}
+
+/* Open-drain emulation for I2C: 1 = release (input, pulled up), 0 = drive low */
+static void
+vc_od(int pin, int val)
+{
+	if (val) {
+		vc_gpio_dir(pin, true);
+	} else {
+		vc_gpio_set(pin, 0);
+		vc_gpio_dir(pin, false);
+	}
+}
+
+/* ----------------------------------------------------------------- I2C */
+
+#define I2C_DLY()	DELAY(5)
+
+static void
+vc_i2c_start(void)
+{
+	vc_od(VC_GPIO_SDA, 1); vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+	vc_od(VC_GPIO_SDA, 0); I2C_DLY();
+	vc_od(VC_GPIO_SCL, 0); I2C_DLY();
+}
+
+static void
+vc_i2c_stop(void)
+{
+	vc_od(VC_GPIO_SDA, 0); I2C_DLY();
+	vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+	vc_od(VC_GPIO_SDA, 1); I2C_DLY();
+}
+
+/* returns 0 on ACK */
+static int
+vc_i2c_wbyte(u8 b)
+{
+	int i, nak;
+
+	for (i = 7; i >= 0; i--) {
+		vc_od(VC_GPIO_SDA, (b >> i) & 1); I2C_DLY();
+		vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+		vc_od(VC_GPIO_SCL, 0); I2C_DLY();
+	}
+	vc_od(VC_GPIO_SDA, 1); I2C_DLY();
+	vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+	nak = vc_gpio_get(VC_GPIO_SDA);
+	vc_od(VC_GPIO_SCL, 0); I2C_DLY();
+	return (nak);
+}
+
+static u8
+vc_i2c_rbyte(bool ack)
+{
+	int i;
+	u8 b = 0;
+
+	vc_od(VC_GPIO_SDA, 1);
+	for (i = 7; i >= 0; i--) {
+		vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+		b |= vc_gpio_get(VC_GPIO_SDA) << i;
+		vc_od(VC_GPIO_SCL, 0); I2C_DLY();
+	}
+	vc_od(VC_GPIO_SDA, ack ? 0 : 1); I2C_DLY();
+	vc_od(VC_GPIO_SCL, 1); I2C_DLY();
+	vc_od(VC_GPIO_SCL, 0); I2C_DLY();
+	vc_od(VC_GPIO_SDA, 1);
+	return (b);
+}
+
+static int
+vc_i2c_write_reg(u8 addr, u8 reg, u8 val)
+{
+	int err;
+
+	vc_i2c_start();
+	err = vc_i2c_wbyte(addr << 1) || vc_i2c_wbyte(reg) || vc_i2c_wbyte(val);
+	vc_i2c_stop();
+	return (err ? EIO : 0);
+}
+
+static int
+vc_i2c_read_reg(u8 addr, u8 reg, u8 *val)
+{
+	int err;
+
+	vc_i2c_start();
+	err = vc_i2c_wbyte(addr << 1) || vc_i2c_wbyte(reg);
+	if (!err) {
+		vc_i2c_start();
+		err = vc_i2c_wbyte((addr << 1) | 1);
+		if (!err)
+			*val = vc_i2c_rbyte(false);
+	}
+	vc_i2c_stop();
+	return (err ? EIO : 0);
+}
+
+/* Pulse the 88E1514 reset (PCA9557@0x18 pin 4), touching no other pin. */
+static void
+vc_release_phys(void)
+{
+	u8 out, cfg;
+	u8 bit = 1 << VC_PCA_PHY_RESET;
+
+	if (vc_i2c_read_reg(VC_PCA_ADDR, 1, &out) ||
+	    vc_i2c_read_reg(VC_PCA_ADDR, 3, &cfg)) {
+		printf("vcigb: PCA9557@0x%x does not answer\n", VC_PCA_ADDR);
+		return;
+	}
+	vc_i2c_write_reg(VC_PCA_ADDR, 1, out & ~bit);	/* low */
+	vc_i2c_write_reg(VC_PCA_ADDR, 3, cfg & ~bit);	/* output */
+	pause("vcrst", hz);
+	vc_i2c_write_reg(VC_PCA_ADDR, 1, out | bit);	/* release */
+	pause("vcrst", hz);
+	printf("vcigb: WAN PHY reset released (PCA9557 out 0x%02x cfg 0x%02x)\n",
+	    out | bit, cfg & ~bit);
+}
+
+/* ---------------------------------------------------------------- MDIO */
+
+#define MDIO_DLY()	DELAY(1)
+
+static void
+vc_mdc_pulse(void)
+{
+	vc_gpio_set(VC_GPIO_MDC, 1); MDIO_DLY();
+	vc_gpio_set(VC_GPIO_MDC, 0); MDIO_DLY();
+}
+
+static void
+vc_mdio_out(u32 val, int bits)
+{
+	int i;
+
+	for (i = bits - 1; i >= 0; i--) {
+		vc_gpio_set(VC_GPIO_MDIO, (val >> i) & 1);
+		MDIO_DLY();
+		vc_mdc_pulse();
+	}
+}
+
+static void
+vc_mdio_hdr(int op, int phy, int reg)
+{
+	vc_gpio_dir(VC_GPIO_MDC, false);
+	vc_gpio_set(VC_GPIO_MDIO, 1);
+	vc_gpio_dir(VC_GPIO_MDIO, false);
+	vc_mdio_out(0xffffffff, 32);			/* preamble */
+	vc_mdio_out(0x1, 2);				/* start */
+	vc_mdio_out(op, 2);				/* 2 = read, 1 = write */
+	vc_mdio_out(phy, 5);
+	vc_mdio_out(reg, 5);
+}
+
+static int
+vc_mdio_read(int phy, int reg)
+{
+	int i, val = 0;
+
+	mtx_lock(&vc_gpio_mtx);
+	vc_mdio_hdr(2, phy, reg);
+	/*
+	 * Turnaround.  gpio on Avoton ORs the cached output level into reads
+	 * of an input pin: drive it low before releasing it (Linux
+	 * patch 210-mdio-gpio-clear-level-before-input).
+	 */
+	vc_gpio_set(VC_GPIO_MDIO, 0);
+	vc_gpio_dir(VC_GPIO_MDIO, true);
+	vc_mdc_pulse();
+	vc_mdc_pulse();
+	for (i = 15; i >= 0; i--) {
+		val |= vc_gpio_get(VC_GPIO_MDIO) << i;
+		vc_mdc_pulse();
+	}
+	vc_mdc_pulse();
+	mtx_unlock(&vc_gpio_mtx);
+	return (val);
+}
+
+static void
+vc_mdio_write(int phy, int reg, u16 val)
+{
+	mtx_lock(&vc_gpio_mtx);
+	vc_mdio_hdr(1, phy, reg);
+	vc_mdio_out(0x2, 2);				/* turnaround */
+	vc_mdio_out(val, 16);
+	vc_gpio_dir(VC_GPIO_MDIO, true);
+	vc_mdc_pulse();
+	mtx_unlock(&vc_gpio_mtx);
+}
+
+s32
+e1000_vc_ext_read_reg(struct e1000_hw *hw, u32 offset, u16 *data)
+{
+	if (offset > MAX_PHY_REG_ADDRESS)
+		return (-E1000_ERR_PARAM);
+	*data = vc_mdio_read(hw->phy.addr, offset);
+	return (E1000_SUCCESS);
+}
+
+s32
+e1000_vc_ext_write_reg(struct e1000_hw *hw, u32 offset, u16 data)
+{
+	if (offset > MAX_PHY_REG_ADDRESS)
+		return (-E1000_ERR_PARAM);
+	vc_mdio_write(hw->phy.addr, offset, data);
+	return (E1000_SUCCESS);
+}
+
+/* ------------------------------------------------- I354 MDIO (switch SMI) */
+
+static u16
+vc_swfw_mask(u8 func)
+{
+	switch (func) {
+	case 1: return (E1000_SWFW_PHY1_SM);
+	case 2: return (E1000_SWFW_PHY2_SM);
+	case 3: return (E1000_SWFW_PHY3_SM);
+	default: return (E1000_SWFW_PHY0_SM);
+	}
+}
+
+static int
+vc_mdic(struct e1000_hw *hw, int addr, int reg, bool write, u16 *val)
+{
+	u32 mdic;
+	int i, err = 0;
+	u16 mask = vc_swfw_mask(hw->dev_spec._82575.vc_func);
+
+	if (hw->mac.ops.acquire_swfw_sync(hw, mask))
+		return (EBUSY);
+
+	mdic = E1000_READ_REG(hw, E1000_MDICNFG);
+	mdic &= (E1000_MDICNFG_EXT_MDIO | E1000_MDICNFG_COM_MDIO);
+	mdic |= (u32)addr << E1000_MDICNFG_PHY_SHIFT;
+	E1000_WRITE_REG(hw, E1000_MDICNFG, mdic);
+
+	mdic = ((u32)reg << E1000_MDIC_REG_SHIFT) |
+	    ((u32)addr << E1000_MDIC_PHY_SHIFT);
+	if (write)
+		mdic |= E1000_MDIC_OP_WRITE | *val;
+	else
+		mdic |= E1000_MDIC_OP_READ;
+	E1000_WRITE_REG(hw, E1000_MDIC, mdic);
+
+	for (i = 0; i < E1000_GEN_POLL_TIMEOUT * 3; i++) {
+		DELAY(50);
+		mdic = E1000_READ_REG(hw, E1000_MDIC);
+		if (mdic & E1000_MDIC_READY)
+			break;
+	}
+	if (!(mdic & E1000_MDIC_READY))
+		err = ETIMEDOUT;
+	else if (mdic & E1000_MDIC_ERROR)
+		err = EIO;
+	else if (!write)
+		*val = (u16)mdic;
+
+	hw->mac.ops.release_swfw_sync(hw, mask);
+	return (err);
+}
+
+static u16
+vc_r(struct e1000_hw *hw, int addr, int reg)
+{
+	u16 v = 0xffff;
+
+	vc_mdic(hw, addr, reg, false, &v);
+	return (v);
+}
+
+static void
+vc_w(struct e1000_hw *hw, int addr, int reg, u16 v)
+{
+	vc_mdic(hw, addr, reg, true, &v);
+}
+
+/* Global2 SMI PHY command/data: reach the switch-internal PHYs and SerDes */
+static void
+vc_smi_wait(struct e1000_hw *hw)
+{
+	int i;
+
+	for (i = 0; i < 100 && (vc_r(hw, 0x1c, 0x18) & 0x8000); i++)
+		DELAY(10);
+}
+
+static void
+vc_smiw(struct e1000_hw *hw, int dev, int reg, u16 v)
+{
+	vc_w(hw, 0x1c, 0x19, v);
+	vc_w(hw, 0x1c, 0x18, 0x9400 | (dev << 5) | reg);
+	vc_smi_wait(hw);
+}
+
+static u16
+vc_smir(struct e1000_hw *hw, int dev, int reg)
+{
+	vc_w(hw, 0x1c, 0x18, 0x9800 | (dev << 5) | reg);
+	vc_smi_wait(hw);
+	return (vc_r(hw, 0x1c, 0x19));
+}
+
+/* velo540-switch switch_up(): plain unmanaged 4-port switch */
+static void
+vc_switch_up(struct e1000_hw *hw)
+{
+	u16 id, v, st;
+	int d, p;
+
+	id = vc_r(hw, 0x10, 3);
+	if ((id & 0xfff0) != 0x1760) {
+		printf("vcigb: func %u: no 88E6176 on the SMI bus (id 0x%04x)\n",
+		    hw->dev_spec._82575.vc_func, id);
+		return;
+	}
+	vc_smiw(hw, 0xf, 22, 1);
+	v = vc_smir(hw, 0xf, 0);
+	vc_smiw(hw, 0xf, 0, (v | 0x8100) & ~0x1800);
+	pause("vcsw", hz);
+	st = vc_r(hw, 0x14, 0);
+	vc_w(hw, 0x14, 0, st & ~0x1000);
+	vc_w(hw, 0x14, 1, 0x000e);
+	for (d = 0; d < 4; d++) {
+		vc_smiw(hw, d, 22, 0);
+		vc_smiw(hw, d, 0, 0x9140);
+	}
+	for (p = 0; p <= 4; p++) {
+		v = vc_r(hw, 0x10 + p, 4);
+		vc_w(hw, 0x10 + p, 4, (v & ~3) | 3);
+	}
+	for (p = 5; p <= 6; p++) {
+		v = vc_r(hw, 0x10 + p, 4);
+		vc_w(hw, 0x10 + p, 4, v & ~3);
+	}
+	printf("vcigb: func %u: 88E6176 0x%04x up (unmanaged), port4 status 0x%04x\n",
+	    hw->dev_spec._82575.vc_func, id, vc_r(hw, 0x14, 0));
+}
+
+/* ------------------------------------------------- MAC side, funcs 0/1 */
+
+static s32
+e1000_vc_setup_serdes_forced(struct e1000_hw *hw)
+{
+	u32 reg;
+
+	E1000_WRITE_REG(hw, E1000_SCTL, E1000_SCTL_DISABLE_SERDES_LOOPBACK);
+
+	reg = E1000_READ_REG(hw, E1000_PCS_CFG0);
+	reg |= E1000_PCS_CFG_PCS_EN;
+	E1000_WRITE_REG(hw, E1000_PCS_CFG0, reg);
+
+	reg = E1000_READ_REG(hw, E1000_CTRL);
+	reg |= E1000_CTRL_SLU | E1000_CTRL_SPD_1000 | E1000_CTRL_FD |
+	    E1000_CTRL_FRCSPD | E1000_CTRL_FRCDPX;
+	E1000_WRITE_REG(hw, E1000_CTRL, reg);
+
+	reg = E1000_READ_REG(hw, E1000_PCS_LCTL);
+	reg &= ~(E1000_PCS_LCTL_AN_ENABLE | E1000_PCS_LCTL_AN_RESTART |
+	    E1000_PCS_LCTL_AN_TIMEOUT);
+	reg |= E1000_PCS_LCTL_FLV_LINK_UP | E1000_PCS_LCTL_FSV_1000 |
+	    E1000_PCS_LCTL_FDV_FULL | E1000_PCS_LCTL_FSD |
+	    E1000_PCS_LCTL_FORCE_FCTRL | E1000_PCS_LCTL_FORCE_LINK;
+	E1000_WRITE_REG(hw, E1000_PCS_LCTL, reg);
+
+	return (E1000_SUCCESS);
+}
+
+/* ------------------------------------------------------------- probe */
+
+/*
+ * Called from e1000_init_phy_params_82575() (NVM already usable).
+ * Returns E1000_VC_NONE for anything that is not an edge5x0 I354,
+ * E1000_VC_SWITCH when the function was set up as a switch uplink (no PHY),
+ * E1000_VC_EXTPHY when the PHY must be reached over the GPIO bus.
+ */
+int
+e1000_vc_probe(struct e1000_hw *hw)
+{
+	struct e1000_dev_spec_82575 *ds = &hw->dev_spec._82575;
+	u16 nvm[2] = { 0, 0 };
+	u8 func;
+	int role;
+
+	ds->vc_role = E1000_VC_NONE;
+	if (hw->mac.type != e1000_i354)
+		return (E1000_VC_NONE);
+	if (e1000_read_nvm(hw, VC_NVM_WORD, 2, nvm) != E1000_SUCCESS)
+		return (E1000_VC_NONE);
+	if (nvm[0] != VC_ID || nvm[1] != VC_ID_EDGE5X0)
+		return (E1000_VC_NONE);
+	if (!vc_gpio_init())
+		return (E1000_VC_NONE);
+
+	func = (E1000_READ_REG(hw, E1000_STATUS) & E1000_STATUS_FUNC_MASK) >>
+	    E1000_STATUS_FUNC_SHIFT;
+	ds->vc_func = func;
+	printf("vcigb: VeloCloud edge5x0 I354 func %u\n", func);
+
+	if (func <= 1) {
+		role = E1000_VC_SWITCH;
+		hw->phy.media_type = e1000_media_type_internal_serdes;
+		hw->phy.type = e1000_phy_none;
+		hw->mac.autoneg = false;
+		hw->mac.ops.setup_physical_interface =
+		    e1000_vc_setup_serdes_forced;
+		if (!vc_switch_done[func]) {
+			vc_switch_done[func] = true;
+			vc_switch_up(hw);
+		}
+	} else {
+		role = E1000_VC_EXTPHY;
+		hw->phy.addr = func - 2;
+		mtx_lock(&vc_gpio_mtx);
+		if (!vc_phys_released) {
+			vc_phys_released = true;
+			mtx_unlock(&vc_gpio_mtx);
+			vc_release_phys();
+		} else
+			mtx_unlock(&vc_gpio_mtx);
+	}
+	ds->vc_role = role;
+	return (role);
+}
+
+/* LED wiring (vendor igb_vc_setup_m88e1514): LED0 = 1G link, LED1 = 10/100 + act */
+void
+e1000_vc_phy_leds(struct e1000_hw *hw)
+{
+	if (hw->dev_spec._82575.vc_role != E1000_VC_EXTPHY)
+		return;
+	vc_mdio_write(hw->phy.addr, 22, 3);
+	vc_mdio_write(hw->phy.addr, 16, 0x0817);
+	vc_mdio_write(hw->phy.addr, 17, 0x0005);
+	vc_mdio_write(hw->phy.addr, 22, 0);
+}
+
+/* ------------------------------------------------------------ sysctls */
+
+/*
+ * dev.vcigb.N.vc_ports: link state of the four user ports of an 88E6176
+ * (switch port registers 0x10-0x13, reg 0 = port status), one line each:
+ *   "<switch port> <up|down> <10|100|1000> <full|half>"
+ */
+static int
+vc_sysctl_ports(SYSCTL_HANDLER_ARGS)
+{
+	struct e1000_hw *hw = arg1;
+	struct sbuf sb;
+	u16 st;
+	int p, err;
+	static const char *spd[] = { "10", "100", "1000", "?" };
+
+	sbuf_new_for_sysctl(&sb, NULL, 128, req);
+	for (p = 0; p < 4; p++) {
+		st = 0xffff;
+		if (vc_mdic(hw, 0x10 + p, 0, false, &st) != 0 || st == 0xffff) {
+			sbuf_printf(&sb, "%d error\n", p);
+			continue;
+		}
+		sbuf_printf(&sb, "%d %s %s %s\n", p,
+		    (st & 0x0800) ? "up" : "down", spd[(st >> 8) & 3],
+		    (st & 0x0400) ? "full" : "half");
+	}
+	err = sbuf_finish(&sb);
+	sbuf_delete(&sb);
+	return (err);
+}
+
+void
+e1000_vc_add_sysctls(device_t dev, struct e1000_hw *hw)
+{
+	struct sysctl_ctx_list *ctx = device_get_sysctl_ctx(dev);
+	struct sysctl_oid_list *kids =
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev));
+	static const char *roles[] = { "none", "switch", "extphy" };
+	u8 role = hw->dev_spec._82575.vc_role;
+
+	SYSCTL_ADD_STRING(ctx, kids, OID_AUTO, "vc_role", CTLFLAG_RD,
+	    __DECONST(char *, roles[role > 2 ? 0 : role]), 0,
+	    "VeloCloud edge5x0 role of this I354 function");
+	SYSCTL_ADD_U8(ctx, kids, OID_AUTO, "vc_func", CTLFLAG_RD,
+	    &hw->dev_spec._82575.vc_func, 0, "I354 PCI function");
+	if (role == E1000_VC_SWITCH)
+		SYSCTL_ADD_PROC(ctx, kids, OID_AUTO, "vc_ports",
+		    CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_MPSAFE, hw, 0,
+		    vc_sysctl_ports, "A", "88E6176 user port status");
+}
