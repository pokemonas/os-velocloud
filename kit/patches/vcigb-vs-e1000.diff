+static bool
+vcigb_kernel_matches(void)
+{
+	return (VCIGB_KERNCOMMIT[0] == '\0' ||
+	    strstr(version, "-" VCIGB_KERNCOMMIT) != NULL);
+}
+
+static int
+vcigb_probe(device_t dev)
+{
+	static bool warned;
+
+	if (pci_get_vendor(dev) != 0x8086 || pci_get_device(dev) != 0x1f41)
+		return (ENXIO);
+	if (!vcigb_kernel_matches()) {
+		if (vcigb_strict) {
+			if (!warned)
+				printf("vcigb: built for kernel %s, not this one "
+				    "(uname -v); not attaching, set "
+				    "hw.vcigb.strict=0 to override\n",
+				    VCIGB_KERNCOMMIT);
+			warned = true;
+			return (ENXIO);
+		}
+		if (!warned)
+			printf("vcigb: WARNING: built for kernel %s, not this "
+			    "one (uname -v); attaching anyway (hw.vcigb.strict=0)\n",
+			    VCIGB_KERNCOMMIT);
+		warned = true;
+	}
+	device_set_desc(dev, "Intel I354 (VeloCloud edge5x0, vcigb)");
+	return (BUS_PROBE_SPECIFIC);
