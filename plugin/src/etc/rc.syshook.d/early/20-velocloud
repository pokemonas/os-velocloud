#!/bin/sh

# os-velocloud (VeloCloud Edge 520/540): the loader has already loaded
# if_vcigb if enabled; keep the modules in /boot/kernel and /boot/modules in
# line with the installed kernel and report what this boot got.

/usr/local/opnsense/scripts/velocloud/select.sh -q

if ! pciconf -l 2>/dev/null | grep -Eq 'vendor=0x8086 device=0x1f41|chip=0x1f418086'; then
	exit 0
fi

KCOMMIT=$(uname -v | sed -n 's/.*-\([0-9a-f]\{12\}\) .*/\1/p')
if kldstat -q -n if_vcigb; then
	BUILT=$(sysctl -n hw.vcigb.kerncommit 2>/dev/null)
	if [ -n "${BUILT}" ] && [ "${BUILT}" != "${KCOMMIT}" ]; then
		echo "velocloud: if_vcigb built for kernel ${BUILT}, running ${KCOMMIT}"
		logger -t velocloud "if_vcigb built for kernel ${BUILT}, running ${KCOMMIT}; reboot once a matching module is installed"
	fi
elif [ -r /usr/local/etc/velocloud.conf ] && grep -q '^VC_ENABLED=1' /usr/local/etc/velocloud.conf; then
	echo "velocloud: if_vcigb not loaded (no module for kernel ${KCOMMIT}?)"
	logger -t velocloud "if_vcigb not loaded at boot, LAN1-8/GE1/GE2 unavailable"
fi

exit 0
